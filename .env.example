# Copy this file to .env.local and configure your values:

# -----------------------------------------------------------------------------
# 1. Site Metadata & Canonical Domain
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://example.com

# -----------------------------------------------------------------------------
# 2. Free & Cost-Effective Email Delivery (Choose ONE)
# -----------------------------------------------------------------------------

# OPTION 1: Web3Forms (Recommended — 100% Free, Unlimited Forms, 0 Credit Card)
# 1. Visit: https://web3forms.com
# 2. Enter poniayoyinka@gmail.com to receive your free Access Key instantly.
# 3. Paste the key below:
NEXT_PUBLIC_WEB3FORMS_KEY=

# OPTION 2: Formspree (Free tier available)
# 1. Create a form at: https://formspree.io
# 2. Paste your form URL below:
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/mrpeageg

# OPTION 3: Gmail SMTP (Direct Node server delivery)
# 1. Enable 2-Step Verification on Google Account: https://myaccount.google.com/security
# 2. Create 16-character App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=poniayoyinka@gmail.com
# SMTP_PASS=your-16-character-app-password

# -----------------------------------------------------------------------------
# 3. Static Export Mode (GitHub Pages Only)
# -----------------------------------------------------------------------------
# STATIC_EXPORT=true
# NEXT_PUBLIC_BASE_PATH=/your-repo-name
